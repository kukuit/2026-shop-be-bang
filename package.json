    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.3",
    "postcss": "^8",
    "prettier": "^3.6.2",
    "prisma": "^6.17.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
