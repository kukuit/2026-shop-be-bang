FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_ACCESS_SECRET=

# Used only by scripts/set-user-password.mjs; never commit a real password.
INITIAL_USER_PASSWORD=

# Canonical public URL used for absolute Open Graph and Twitter image URLs.
NEXT_PUBLIC_SITE_URL=https://shopbebang.vn

# Lesson-level adaptive questions. Disabled unless explicitly set to true.
NEXT_PUBLIC_GAME_ADAPTIVE_ENABLED=false
NEXT_PUBLIC_GAME_ADAPTIVE_RATIO=0.4
